# ── 資料服務環境變數(複製成 .env 再改)──
# 原型預設:表 id 全空 = 不接任何外部資料源。服務起得來、/healthz 會誠實說「無資料」,
# 前端則走 web/public/ 的 demo 靜態檔。填了表 id 才會真的去拉資料。

# 資料集(表)id 部分覆蓋。key 清單見 app/tables.py DEFAULT_TABLES。
CBW_TABLES_JSON=

# 快照落地目錄(raw.json 等)。預設程序內記憶體 + 此目錄
CBW_DATA_DIR=./_data

# 刷新排程(台北時間,逗號分隔)。收盤後每小時補刷,讓最壞延遲 < 1 小時。
CBW_REFRESH_AT=15:40,16:30,17:30,18:30,19:30,20:30,21:30
# 手動刷新用的 token:POST /internal/refresh?token=<這個值>
CBW_REFRESH_TOKEN=

# ── 認證(留空 = 不驗證,所有 /api/* 直接開放;僅適合本機)──
CBW_REQUIRE_AUTH=false
CBW_OIDC_ISS=
CBW_OIDC_AUD=
CBW_OIDC_JWKS_URL=
CBW_OIDC_LEEWAY=60
# 不驗證模式下,個人化資料掛在哪個假會員 id 底下
CBW_DEV_MEMBER_ID=demo-member

# CORS 白名單(逗號分隔)
CBW_CORS_ORIGINS=http://localhost:5173

# ── 個人化資料儲存 ──
# watchlist 後端:sheet(Google Sheet 當 DB,零 DB 成本)/ providergroup(轉發到你的
# 資料來源方既有自選股 API,見 app/watchlist.py 的 adapter)
CBW_WATCHLIST_BACKEND=sheet
CBW_WATCHLIST_MAX=10
CBW_WATCHLIST_SHEET_ID=
CBW_DRAWINGS_SHEET_ID=
CBW_DRAWINGS_TAB=drawings
# Google Sheet 服務帳號金鑰(二選一:整段 JSON 或檔案路徑)
CBW_GSHEET_SA_JSON=
CBW_GSHEET_SA_FILE=

# providergroup adapter 用(轉發自選股到外部 API)
CBW_CUSTOMGROUP_URL=
CBW_CUSTOMGROUP_PREFIX=CBW-
CBW_CUSTOMGROUP_DOCTYPE=stock
