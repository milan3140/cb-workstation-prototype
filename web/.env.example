# ── 前端環境變數(複製成 .env.local 再改;全部留空 = 離線 demo 模式)──

# 資料 API 位址。留空 → 讀同源靜態檔(web/public/ 的 demo 資料),整站可操作。
# 填了 → 一律改打 `${VITE_DATA_API_URL}/api/<path>`,並帶 OIDC access_token。
VITE_DATA_API_URL=

# 即時報價來源(回 {asof, quotes:{代號:價}})。留空 → 不輪詢,清單用收盤快照值。
VITE_QUOTES_URL=

# 畫線雲端同步 API。留空 → 畫線只存瀏覽器本機(IndexedDB),不外傳。
VITE_DRAWINGS_API_URL=

# ── OIDC 登入(留空 = 不啟用,全站 guest;個人化資料只存本機)──
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SERVICE_PATH=
# 兩個都設好後,設 true 才會擋未登入者
VITE_REQUIRE_LOGIN=false
